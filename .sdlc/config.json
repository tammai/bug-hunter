{
  "min_plugin_version": "3.1.0",
  "project": {
    "kind": "greenfield",
    "stack": [
      "python"
    ]
  },
  "docs_dir": "docs/sdlc",
  "commands": {
    "install": "uv sync --frozen",
    "test": "uv run pytest",
    "lint": "uv run ruff check .",
    "typecheck": null,
    "build": null
  },
  "ci": {
    "os": [
      "ubuntu-latest",
      "windows-latest"
    ]
  },
  "prd": "docs/sdlc/prd.md",
  "deploy": {
    "target": "other",
    "environments": [
      {
        "name": "github-release",
        "routine": false
      }
    ],
    "runbook": "knowledge/runbooks/release.md"
  }
}
