{
  "patterns": [
    {"name": "anthropic-key", "regex": "sk-ant-[a-z0-9_-]{20,}", "guardrail": true, "severity": "critical"},
    {"name": "openai-project-key", "regex": "sk-proj-[a-z0-9_-]{20,}", "guardrail": true, "severity": "critical"},
    {"name": "openai-key", "regex": "sk-[a-z0-9]{32,}", "guardrail": true, "severity": "critical"},
    {"name": "github-token", "regex": "gh[pousr]_[a-z0-9]{30,}", "guardrail": true, "severity": "critical"},
    {"name": "github-pat", "regex": "github_pat_[a-z0-9_]{30,}", "guardrail": true, "severity": "critical"},
    {"name": "stripe-live-key", "regex": "[rs]k_live_[a-z0-9]{20,}", "guardrail": true, "severity": "critical"},
    {"name": "google-api-key", "regex": "AIza[0-9a-z_-]{35}", "guardrail": true, "severity": "high"},
    {"name": "aws-access-key-id", "regex": "AKIA[0-9A-Z]{16}", "guardrail": true, "severity": "critical", "ignore_case": false},
    {"name": "slack-token", "regex": "xox[baprs]-[a-z0-9-]{10,}", "guardrail": true, "severity": "high"},
    {"name": "private-key", "regex": "-{5}BEGIN [A-Z ]*PRIVATE KEY", "guardrail": true, "severity": "critical", "ignore_case": false},
    {"name": "url-credentials", "regex": "[a-z][a-z0-9+.-]*://[^\\s:/@'\"]+:(?P<value>[^\\s@/'\"]+)@", "severity": "high"},
    {"name": "env-assignment", "regex": "^\\s*(?:export\\s+)?[a-z0-9_]*(?:secret|token|key|password|passwd)[a-z0-9_]*\\s*=\\s*['\"]?(?P<value>[^\\s'\"#]+)", "env_only": true, "severity": "high"}
  ],
  "placeholders": ["xxxx", "changeme", "change_me", "example", "dummy", "placeholder", "your_", "your-"],
  "low_dirs": ["test", "tests", "__tests__", "spec", "specs", "fixtures", "__fixtures__", "testdata", "examples"],
  "skip_dirs": ["node_modules", "vendor", ".git"],
  "max_bytes": 1000000
}
